~import "Module.ymm"
define function main(): {
	define class Animal: {
	#public:
	define function __construct__(races: string(), names: string(), ages: int()): {
		let self.race = races
		let self.name = names
		let self.age = ages
	}
	define function __display__(): {
		return f"{self.race} {self.name} {self.age}"
   }
	#private:
	#protected:
	}
	define class Human : inherits(Animal): {
	#public:
	define function __construct__(races: string(), names: string(), ages: int(), height:int()): {
		super().__construct__(races, names, ages)
		let self.height = height
	}
	define function __display__()-> string(): {
		return super().__display__() + f" height {self.height}"
   }
	#private:
	#protected:
}
	let doggo = Animal("dog", "wolfy", 2)
	let mmd = Human("human", "mohammed", 22, 183)
	print(mmd)
}
