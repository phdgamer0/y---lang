import "Module.ymm"

define function main(): {
	InitWindow(WIN_WIDTH,WIN_HEIGHT,"drawing a function in y--")
	let pink = Color(255, 150, 170, 255)
	let yellow = Color(255,255,0,255)
	let zoom,stre := 10.0,10.0
	let quadratic = define lambda function(x: float(),stretch:float(1.0)) -> float(): { return float(stretch*(x*x + 1)) }
	let offsetx, offsety = 120,60
	let mouse_x, mouse_y
	let toggled_zoom = true
	~SetTargetFPS(60)
	while (not bool(WindowShouldClose())) do: {
		BeginDrawing()
		ClearBackground(BLACK)
		DrawFPS(10, 10)
		DrawText(f'{string(zoom).strip("0").center(10," ")}\n{string(stre).strip("0").center(10," ")}', WIN_WIDTH - offsetx, 10, 20, WHITE)
		DrawRectangleV(<WIN_WIDTH - offsetx - 1, offsety-1>,<32 ,32>,WHITE)
		DrawRectangleV(<WIN_WIDTH - offsetx, offsety>,<30,30>,BLACK)
		DrawText(f'-', WIN_WIDTH - offsetx + 11, offsety + 6, 20, WHITE)
		`----------------------------------------------------------------`
		DrawRectangleV(<WIN_WIDTH - offsetx + 41, offsety - 1 >, <32 , 32 >, WHITE)
		DrawRectangleV(<WIN_WIDTH - offsetx + 42, offsety >, <30, 30 >, BLACK)
		DrawText(f'+', WIN_WIDTH - offsetx + 52, offsety + 6, 20, WHITE)
		mouse_x, mouse_y = GetMouseX(), GetMouseY()
		if IsKeyPressed(32): toggled_zoom = not toggled_zoom
		if mouse_x >= 680 and mouse_x <= 710 and mouse_y >= 60 and mouse_y <= 90 and IsMouseButtonPressed(0): {
			if toggled_zoom: zoom -= 1.0
			else: stre -= 2.0
		}
		if mouse_x >= 720 and mouse_x <= 750 and mouse_y >= 60 and mouse_y <= 90 and IsMouseButtonPressed(0): {
			if toggled_zoom: zoom += 1.0
			else: stre += 2.0
		}
		steup_axis(THICKNESS-1,yellow)
		draw_function(WIN_WIDTH,WIN_HEIGHT,quadratic,pink,zoom,stre)
		EndDrawing()
	}
	CloseWindow()
}
