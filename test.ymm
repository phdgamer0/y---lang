import Random
import Os
import FileStream
import Json
define function main(): {
	define class Player: {
		#public:
			define function __construct__(Name:string(), Health:int(100), Level:int(1), Xp:float(0.0), Class:string('Warrior')):{
				if length(Name) >= 3 nand Name.isalnum(): throw ArgumentError, "name should be alphanumerical and be longer than 3 charachters"
				self.Name = Name
				self.Health = Health
				self.Xp = Xp
				self.Level = Level
				self.Class = Class if Class is in obj.classTypes else RandChoice(obj.classTypes)
				obj.population++
			}
			define function __display__():{
			  return f'╔══════════════════╦══════════════╦══════════╦══════════╦══════════════╗\n║ {string("Name").center(16)} ║ {string("Class").center(12)} ║ {string("Health").center(8)} ║ {string("Level").center(8)} ║ {string("XP").center(12)} ║\n╠══════════════════╬══════════════╬══════════╬══════════╬══════════════╣\n║ {string(self.Name).center(16)} ║ {string(self.Class).center(12)} ║ {string(self.Health).center(8)} ║ {string(self.Level).center(8)} ║ {(string(self.Xp).rstrip("0")+"0").center(12)} ║\n╚══════════════════╩══════════════╩══════════╩══════════╩══════════════╝'
			}
		#private:
			
		#protected:
			let obj.population = 0
			let const obj.classTypes := ['Wizard', 'Warrior', 'Archer', 'Bandit']
			let self.Name := ""
			let self.Health := 0
			let self.Xp := 0.0
			let self.Class := ""
			let self.Level := 0
	}
	~ let yazdan = Player("phd", 999, omit, omit, 'Wizard')
	~ print(yazdan)
	~ let testinClass
	~ if Exists("./", "testinClass.json"): testinClass = Open("testinClass.json")
	~ else:{
	~ 	Make("./", "testinClass.json")
	~ 	testinClass = Open("testinClass.json")
	~ }
	~ print("parsing...")
	~ let parsedJson = Stringify(yazdan, 3)
	~ print("parsing finished")
	~ testinClass.Clear()
	~ testinClass.Write(parsedJson)
	~ print("finished writing")
	~ testinClass.Close()
	~ print("finished exporting")
	let testinClass = SafeOpen("testinClass.json")
	let rawFile = testinClass.Read()
	let p1 = JsonObject.Parse(rawFile)
	print(p1.Name)
}