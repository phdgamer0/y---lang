import "Module.ymm"
let const DEFAULT_LENGTH = 120
let const STARTING_ANG = float(PI/2.0)
let const DEFAULT_ANG = float(PI/9.0)
let const STARTING_THICNESS = 10
let const DEFAULT_COEF = float(0.8)
define function draw_branch(start:vector(),len:int(),ang:float(),thic:float()):{
	if len<10: {return}
	let end = <start[0]+Cos(ang)*len,start[1]-Sin(ang)*len>
	DrawLineEx(start,end,thic,WHITE)
	let angL, angR := (ang-DEFAULT_ANG), (ang+DEFAULT_ANG)
	draw_branch(end,len*DEFAULT_COEF, angL, thic*DEFAULT_COEF)
	draw_branch(end,len*DEFAULT_COEF, angR, thic*DEFAULT_COEF)
}
define function main(): {
	InitWindow(WIN_WIDTH, WIN_HEIGHT, "farcto")
	SetTargetFPS(60)
	while not WindowShouldClose() do:{
		BeginDrawing()
		ClearBackground(BLACK)
		draw_branch(<WIN_WIDTH/2,WIN_HEIGHT>,DEFAULT_LENGTH,STARTING_ANG,STARTING_THICNESS)
		EndDrawing()
	}
}
