import "Module.ymm"
let const RADH = 70
let const RADV = 40
define function main(): {
	InitWindow(800,600,"Clock sim")
	let pink = Color(255, 150, 170, 255)
	let yellow = Color(255,255,0,255)
	let center = vector(400, 300)
	let gray = Color(230, 230, 230, 255)
	let black = Color(0, 0, 0, 255)
	let white = Color(255, 255, 255, 255)
	SetTargetFPS(60)
	while (not bool(WindowShouldClose())) do: {
		BeginDrawing()
		ClearBackground(pink)
		DrawFPS(10, 10)
		~draw_clock(center, gray, black)
		~DrawEllipse(400+RADV, 300, RADH + 1, RADV+1, black)
		DrawEllipse(400+RADV, 300, RADH, RADV, white)
		~DrawEllipse(400, 300+RADV, RADV + 1, RADH + 1, black)
		DrawEllipse(400, 300 + RADV, RADV, RADH, white)
		~DrawEllipse(400 - RADV, 300, RADH + 1, RADV + 1, black)
		DrawEllipse(400 - RADV, 300, RADH, RADV, white)
		~DrawEllipse(400, 300 - RADV, RADV + 1, RADH + 1, black)
		DrawEllipse(400, 300 - RADV, RADV, RADH, white)
		~DrawCircle(400, 300, RADV + 1, black)
		DrawCircle(400, 300, RADV,yellow)
		
		EndDrawing()
	}
	CloseWindow()
}
