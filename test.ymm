~import "Module.ymm"
define function main(): {
	define class Enum: {
	#private:
		let self.counter = 0
		let self.data = dict()
	#public:
		define function __construct__(* args): {
			for arg in args do: {
			self.data[arg] = self.counter
			self.counter++
			}
		}
		define function __display__(): {
			return self.data
		}
	
	#protected:
	}
	let my_enum1 = Enum("A", "B", "C", "D")
	let my_enum2 = Enum("E", "F", "G", "H")
	let my_enum3 = Enum("I", "J", "K", "L")
	let my_enum4 = Enum("M", "N", "O", "P")
	let lis = [my_enum1, my_enum2, my_enum3, my_enum4]
	let a = [10, 20]
	let b = a
	let c = @a
	let d = $a
	~delete(@c)
	print(a.adress(),b.adress(),c.adress(),d.adress())
}
