import "Module.ymm"

define function main(): {
	InitWindow(WIN_WIDTH,WIN_HEIGHT,"my paint")
	SetTargetFPS(144)
	let color_pallet = [WHITE, RED, GREEN, BLUE]
	let pointer, size = 0, 10
	let mouse_x, mouse_y
	let buffer = set()
	while (not WindowShouldClose()) do: {
		BeginDrawing()
		ClearBackground(BLACK)
		DrawFPS(10, 10)
		for vector_elements in buffer do: {
			DrawCircleV(vector_elements[0], vector_elements[2], color_pallet[vector_elements[1]])
		}
		mouse_x, mouse_y = GetMouseX(), GetMouseY()
		if IsKeyPressed(258): pointer = (pointer+1)%4
		elif IsKeyPressed(259): buffer.clear()
		elif IsKeyPressed(45): size -= 1
		elif IsKeyPressed(61): size += 1
		elif mouse_x >= 0 and mouse_x <= WIN_WIDTH and mouse_y >= 0 and mouse_y <= WIN_HEIGHT and IsMouseButtonDown(0):
		buffer.add((<mouse_x, mouse_y >, $pointer, $size))
		elif mouse_x >= 0 and mouse_x <= WIN_WIDTH and mouse_y >= 0 and mouse_y <= WIN_HEIGHT and not IsMouseButtonDown(0):
		DrawCircleV(<mouse_x, mouse_y >, size, color_pallet[pointer])
		
		EndDrawing()
	}
	CloseWindow()
}
