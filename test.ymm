~import "Module.ymm"
define function main(): {
	define class Vec3D: {
	#public:
		define function __construct__(x: float(0.0), y: float(0.0), z: float(0.0))->object(): {
			let self.vect:= [x, y, z]
		}
		define function __display__(): {
			return f"<{self.vect[0]}, {self.vect[1]}, {self.vect[2]}>"
		}
		define function __times__(other): {
			if typeof (other) === "instance": {
				let result:= float()
				for i, j in self.vect, other.vect do: {
					result += i*j
				}
				return result
			}
			else: {
				for i in self.vect do: {
					i*=other
				}
				return self
			}
		}
		define function __times_eq__(other): {
			if typeof (other) === "instance": {
				let result:= float()
				for i, j in self.vect, other.vect do: {
					result += i*j
				}
				return result
			}
			else: {
				for i in self.vect do: {
					i*=other
				}
				return self*2
			}
		}
	#private:
	#protected:
	}
	let my_vect = Vec3D(1, 2, 3)
	my_vect*2
	print(my_vect*2)
}
