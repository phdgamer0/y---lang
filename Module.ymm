define function matmar():{
	define class Matrix: {
			#public:
				define function __construct__(row:int(0), col:int(0), *args): {
					let self.mat := []
					self.MaxVal = args.max() if args else 0
					self.MinVal = args.min() if args else 0
					if args.Any_Of(define lambda function(x) -> bool() :{return typeof(x) is not in ["integer", "float"]}): {
						throw TypeError, "non numeric type detected in the matrix, try casting them to float or integers brfore passing them"
					}
					if row and col: {
						assert length(args) <= row * col, f"the values exceed the static matrix's size, try with\nMatrix(omit, omit, {string(args).strip('()')})"
						self.row = row
						self.col = col
						for let i = 0 if i < row then i++ do: {
							self.mat.append([])
							for let j = 0 if j < col then j++ do: {
								self.mat[i].append(args[col * i + j] if length(args)> col * i + j else 0)
							}
						}
					}
					elif row and not col: {
						col = length(args) // row if not length(args) % row or row === 1 else length(args) // row + 1
						self.row = row
						self.col = col
						for let i = 0 if i < row then i++ do:{
							self.mat.append([])
							for let j = 0 if j < col then j++ do: {
								self.mat[i].append(args[col * i + j] if length(args) > col * i + j else 0)
							}
						}
					}
					elif col and not row: {
						row = length(args) // col if not length(args) % col or col === 1 else length(args) // col + 1
						self.row = row
						self.col = col
						for let i = 0 if i < row then i++ do: {
							self.mat.append([])
							for let j = 0 if j < col then j++ do: {
								self.mat[i].append(args[col * i + j] if length(args) > col * i + j else 0)
							}
						}
					}
					else: {
						throw Warning, "row and columns are both omitted, defaulting to row matrix..."
						row = 1
						col = length(args) // row if not length(args) % row or row === 1 else length(args) // row + 1
						self.row = row
						self.col = col
						for let i = 0 if i < row then i++ do: {
							self.mat.append([])
							for let j = 0 if j < col then j++ do: {
								self.mat[i].append(args[col * i + j] if length(args) > col * i + j else 0)
							}
						}
					}
					return self
				}
				define function __display__(): {
					let max = define lambda function(x, y): {return x if x >= y else y}
					let cell = max(length(string(self.MinVal)), length(string(self.MaxVal)))
					let res := ""
						for rows in self.mat do:{
							for let cols = 0 if cols < self.col then cols++ do: {
								res += (' ' * (cell - length(string(rows[cols])))) + f'{string(rows[cols])}'
								if cols + 1 < self.col: res += '  '
								else: res += '\n'
							}
						}
					return res
				}
				define function __plus__(other): {
					if typeof(other) !== "instance": throw TypeError, 'cannot add non-matrices'
					if self.row !== other.row or self.col !== other.col: throw ValueError, 'cannot add matrices with different dimensions'
					let res = obj(self.row,self.col)
					for r1, r2, r3 in self.mat, other.mat, res.mat do: {
						for c1, c2, c3 in r1, r2, r3 do: {
							c3 = c1 + c2
						}
					}
					res.MaxVal = self.MaxVal + other.MaxVal
					res.MinVal = self.MinVal + other.MinVal
					return res
				}
				define function __minus__(other): {
					if typeof(other) !== "instance": throw TypeError, 'cannot subtract non-matrices'
					if self.row !== other.row or self.col !== other.col: throw ValueError, 'cannot subtract matrices with different dimensions'
					let res = obj(self.row,self.col)
					for r1, r2, r3 in self.mat, other.mat, res.mat do: {
						for c1, c2, c3 in r1, r2, r3 do: {
							c3 = c1 - c2
						}
					}
					res.MaxVal = self.MaxVal - other.MaxVal
					res.MinVal = self.MinVal - other.MinVal
					return res
				}
				define function __times__(other): {
					if typeof(other) is not in ['instance', 'integer', 'float']: throw TypeError, "cannot multiply matrix with types other than 'instance', 'integer' and 'float'"
					elif typeof(other) is in ['integer', 'float']: {
						let res = obj(self.row, self.col)
						for r1, r2 in res.mat, self.mat do: {
							for c1, c2 in r1, r2 do: {
								c1 = c2*other
							}
						}
						res.MaxVal = self.MaxVal * other
						return res
					}
					else: {
						assert self.col === other.row, f"A {self.row} x {self.col} matrix cannot be multiplied by a {other.row} x {other.col} matrix"
						let res = obj(self.row, other.col)
						for let i = 0 if i < self.row then i++ do: {
							for let j = 0 if j < other.col then j++ do: {
								for let k = 0 if k < self.col then k++ do: {
									res.mat[i][j] += self.mat[i][k] * other.mat[k][j]
								}
							}
						}
						return res
					}
				}
				define function __r_times__(other): {
					if typeof(other) is not in ['integer', 'float']: throw TypeError, "cannot multiply matrix with types other than 'integer' and 'float'"
					return self * other
				}
				define function __divide__(other): {
					if typeof(other) is not in ['integer', 'float']: throw TypeError, "cannot multiply matrix with types other than 'integer' and 'float'"
					if other: return self*(1/other)  
					else: throw ZeroDivisionError, "cannot divide by 0"
				}
				define function det(): {
					assert self.row === self.col, "cannot take the determinant of a non square matrix"
					if self.row <= 5: return self._det_helper(self.mat)
					else: {
						let temp = obj(self.row, self.col)
						temp.uTri()
						let res = 1
						for let i = 0 if i < self.row then i++ do: {
							for let j = 0 if j < self.col then j++ do: {
								if i === j: res *= temp.mat[i][j]
							}
						}
					}
				}
				define function transpose(): {
					let temp = obj(self.col, self.row, 0)
					for let i = 0 if i < length(self.mat) then i++ do: {
						for let j = 0 if j < length(self.mat[0]) then j++ do: {
							temp.mat[j][i] = self.mat[i][j]
						}
					}
					self.mat = $temp.mat
					swap(@self.row, @self.col)
				}
				define function inv(): {
					let det = self.det()
					if det === 0: throw MathError, 'cannot invert a matrix that is non-square or has a determinant of 0'
					let temp = $self.mat
					for let row = 0 if row < length(self.mat) then row++ do: {
						for let col = 0 if col < length(self.mat[0]) then col++ do: {
							self.mat[row][col] = float(1/det) * ((-1) ** (row + col)) * self._det_helper(self._remove_row_col(temp, row, col))
						}
					}
					self.transpose()
				}
				define function uTri(): {
					let colOp = 0
					let rowOp = 0
					while colOp !== self.col - 1 do: {
						if self.mat[rowOp][colOp] === 0: {
							rowOp++
							if rowOp === self.row - 1: {
								rowOp = 0
								colOp++
							}
							continue
						}
						for let i = rowOp + 1 if i < self.row then i++ do: {
							if self.mat[i][colOp] === 0: continue
							let coef = self.mat[i][colOp] / self.mat[rowOp][colOp]
							for let c = colOp if c < self.col then c++ do: {
								self.mat[i][c] -= self.mat[rowOp][c] * coef 
							}
						}
						colOp++
						rowOp++
					}
				}
				define function unitMat(row:int(),col:int()): {
					assert row === col, 'A unit matrix should be a aquare matrix'
					let res = obj(row, col, 0)
					for let i = 0 if i < row then i++ do: {
						for let j = 0 if j < col then j++ do: {
							if i === j: res.mat[i][j] = 1
							else: res.mat[i][j] = 0
						}
					}
					return res
				}
			#private:
				define function _remove_row_col(lis: list(), i: int(), j: int()) -> list(): {
					let res := []
					for let row = 0 if row < length(lis) then row++ do: {
						if row === i: continue
						res.append([])
						for let col = 0 if col < length(lis[0]) then col++ do:{
							if col === j: continue
							res[-1].append(lis[row][col])
						}
					}
					return res
				}
				define function _det_helper(lis: list()): {
					if length(lis) === 1: return lis[0][0]
					let result = 0
					for let j = 0 if j < length(lis) then j++ do: {
						result += ((-1) ** (j)) * lis[0][j] * self._det_helper(self._remove_row_col(lis, 0, j))
					}
					return result
				}
				let self.MaxVal
				let self.MinVal
			#protected:
				let self.row
				let self.col
		}
}
