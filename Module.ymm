```
import * from Raylib
import * from Math
import Vector

let const W = 800
let const H = 600
let const FPS = 60
let const NAME = "Julian Set"
let const MAX_ITERATION = 300
let const C_REAL = -0.8F
let const C_IMAGINARY = 0.156F
let const K = 100 // 6
let const COLOR_MAP = (
   Color(0XFF, 0XD5, 0X4F, 0XFF),
   Color(0XFF, 0X8C, 0X00, 0XFF),
   Color(0XE6, 0X3E, 0X00, 0XFF),
   Color(0X93, 0X00, 0X77, 0XFF),
   Color(0X3A, 0X00, 0X88, 0XFF),
   Color(0X0A, 0X00, 0X1A, 0XFF)
)
let zoom = 2.0F
let offset_x = 0.0F
let offset_y = 0.0F
let view_width = 4.0 / zoom
let view_height = 3.0 / zoom
let min_x = offset_x - (view_width / 2.0)
let max_x = offset_x + (view_width / 2.0)
let min_y = offset_y - (view_height / 2.0)
let max_y = offset_y + (view_height / 2.0)

define function map_range(current_num:float(), current_range_start:float(), current_range_end:float(), goal_range_start:float(), goal_range_end:float()) -> float():{
   return (current_num - current_range_start) * (goal_range_end - goal_range_start) / (current_range_end - current_range_start) + goal_range_start
}
define function choose_the_best_color(num:int()):{
   if num // K >=  5: return COLOR_MAP[-1]
   let lcolor = COLOR_MAP[num // K]
   let rcolor = COLOR_MAP[num // K + 1]
   let t = (num % K) / K
   let new_r = int(lcolor.r * (1 - t) + rcolor.r * t)
   let new_g = int(lcolor.g * (1 - t) + rcolor.g * t)
   let new_b = int(lcolor.b * (1 - t) + rcolor.b * t)
   return Color(new_r, new_g, new_b, 255)
}
define function main():{
   InitWindow(W, H, NAME)
   SetTargetFPS(FPS)
   BeginDrawing()
   ClearBackground(BLACK)
   for let pixel_x = 0 if pixel_x < W then pixel_x++ do:{
      for let pixel_y = 0 if pixel_y < H then pixel_y++ do:{
         
         let z_real = map_range(pixel_x, 0, W, min_x, max_x)
         let z_imag = map_range(pixel_y, 0, H, min_y, max_y)
         let iteration = 0
         ~ z = z ** 2 + c
         while iteration < MAX_ITERATION and (z_real * z_real + z_imag * z_imag <= 4.0) do:{
            let temp_real = (z_real * z_real) - (z_imag * z_imag) + C_REAL
            let temp_imag = (2.0 * z_real * z_imag) + C_IMAGINARY
            z_imag = temp_imag
            z_real = temp_real
            iteration++
         }
         DrawPixel(pixel_x, pixel_y, choose_the_best_color(iteration))
      }
   }
   let img = LoadImageFromScreen()
   let txt = LoadTextureFromImage(img)
   EndDrawing()
   while not WindowShouldClose() do:{
      BeginDrawing()
      ClearBackground(COLOR_MAP[0])
      DrawTextureV(txt, <0,0>, WHITE)     
      EndDrawing()
   }
   UnloadImage(img)
   UnloadTexture(txt)
   CloseWindow()

}
