define function draw_hour(center, hour, minute, color): {
	let angle = float((hour + minute / 60.0) * PI / 6.0 - PI / 2.0)
DrawLineEx(center, <WIN_WIDTH / 2 + 80 * Cos(angle), WIN_HEIGHT / 2 + 80 * Sin(angle) >, 2, color)
}
define function draw_minute(center, minute, second, color): {
	let smooth_min = float(minute) + (float(second) / 60.0)
	let angle = float(smooth_min * PI / 30.0 - PI / 2.0)
	DrawLineEx(center, <WIN_WIDTH / 2 + 120 * Cos(angle), WIN_HEIGHT / 2 + 120 * Sin(angle) >, 2, color)
}
define function draw_second(center, second, color): {
	let angle = float(second * PI / 30.0 - PI / 2.0)
	DrawLineEx(center, <WIN_WIDTH / 2 + 150 * Cos(angle), WIN_HEIGHT / 2 + 150 * Sin(angle) >, 2, color)
}
define function draw_digital_time(time, x, y, size, text_color, has_bg, bg_color): {
	let h = string(time["hour"]) if time["hour"] >= 10 else "0" + string(time["hour"])
	let m = string(time["min"]) if time["min"] >= 10 else "0" + string(time["min"])
	let s = string(time["sec"]) if time["sec"] >= 10 else "0" + string(time["sec"])
	if has_bg: {
		DrawRectangle(x - 6, y-2, 112, 22, text_color)
		DrawRectangle(x - 5, y - 1, 110, 20, bg_color)
		
	}
	DrawText(f'{h} : {m} : {s}', x, y, size, text_color)
}
define function draw_clock(center, clc_clor, dot_color): {
	draw_clock_body(center, clc_clor, dot_color)
	let time_format = Local(Now())
	draw_digital_time(time_format,WIN_WIDTH/2-50,10,20,dot_color,true,clc_clor)
	draw_hour(center, time_format["hour"], time_format["min"], dot_color)
	draw_minute(center, time_format["min"], time_format["sec"], dot_color)
	draw_second(center, time_format["sec"], Color(255, 0, 0, 255))
	DrawCircleV(center, 3, dot_color)
}
define function foo(): {
	InitWindow(WIN_WIDTH, WIN_HEIGHT,"Clock sim")
	let pink = Color(255, 150, 170, 255)
	let yellow = Color(255, 255, 0, 255)
	let center = vector(400, 300)
	let gray = Color(230, 230, 230, 255)
	let black = Color(0, 0, 0, 255)
	let white = Color(255, 255, 255, 255)
	SetTargetFPS(60)
	while (not bool(WindowShouldClose())) do: {
		BeginDrawing()
		ClearBackground(pink)
		~DrawFPS(10, 10)
		~fill_with_flowers(WIN_WIDTH, WIN_HEIGHT, yellow, RADH, RADV, white, true, 1, black)
		~draw_clock(center, white, black)
		EndDrawing()
	}
	CloseWindow()
}
