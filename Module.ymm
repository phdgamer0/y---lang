import Raylib
import Time
import Vector
import Math
import Random
let const WIN_WIDTH = 800
let const WIN_HEIGHT = 800
let const RADH = 58
let const RADV = 28
let const THICKNESS = 2
define function draw_leaf(centerx, centery, radH, radV, leaf_color, has_shadow, shadow_thickness, shadow_color): {
	if has_shadow: {
		DrawEllipse(centerx + radV, centery, radH + shadow_thickness, radV + shadow_thickness, shadow_color)
		DrawEllipse(centerx - radV, centery, radH + shadow_thickness, radV + shadow_thickness, shadow_color)
		DrawEllipse(centerx, centery + radV, radV + shadow_thickness, radH + shadow_thickness, shadow_color)
		DrawEllipse(centerx, centery - radV, radV + shadow_thickness, radH + shadow_thickness, shadow_color)
	}
	DrawEllipse(centerx + radV, centery, radH, radV, leaf_color)
	DrawEllipse(centerx - radV, centery, radH, radV, leaf_color)
	DrawEllipse(centerx, centery + radV, radV, radH, leaf_color)
	DrawEllipse(centerx, centery - radV, radV, radH, leaf_color)
}
define function draw_flower(centerx, centery, center_color, radH, radV, leaf_color, has_shadow, shadow_thickness, shadow_color): {
	draw_leaf(centerx, centery, radH, radV, leaf_color, has_shadow, shadow_thickness, shadow_color)
	if has_shadow: DrawCircle(centerx, centery, radV + shadow_thickness, shadow_color)
	DrawCircle(centerx, centery, radV, center_color)
}
define function fill_with_flowers(win_w, win_h, center_color, radH, radV, leaf_color, has_shadow, shadow_thickness, shadow_color): {
	for i in 40...win_w...80 do: {
		for j in 40...win_h...80 do: {
			draw_flower(i, j, center_color, radH / 3, radV / 3, leaf_color, has_shadow, shadow_thickness, shadow_color)
		}
	}
}
define cached function fib(n: int()) -> int(): {
	if n is in [0, 1]: return n
	else : return (fib(n - 1) + fib(n - 2))
}
define function fac(n: int()) -> int(): {
	if n is in [0, 1]: return 1
	else: return n * fac(n - 1)
}
define function flatten_test($arg): {
	if typeof (arg) is not in "list set tuple".split(" "): {
		return arg
	}
	let res = []
	for small_args in arg do: {
		if typeof (small_args) is in "list set tuple".split(" "): {
			for smaller_args in flatten_test(small_args) do: { res.append(smaller_args) }
		}
		else: res.append(small_args)
	}
	switch (typeof (arg)):{
		case "set" then do: { return set(res) }
		case "tuple" do: { return tuple(res) }
		default do: return res
	}
}
define function find_angle_between_2_vectors(v1: vector(), v2: vector()) -> float(): {
	if v1.dimension() !== v2.dimension(): return -1
	let alpha = (v1 * v2) / (v1.magnitude() * v2.magnitude())
	return (RadToDeg(Arccos(alpha)))
}
define function radix_sort(arr: list()) -> list(): {
	let res = [[]] * 10
	let exp, max_val = 1, arr.max()
	while max_val // exp > 0 do:{
		while length(arr) > 0 do: {
			let val = arr.pop()
			res[val//exp % 10].append(val)
		}
		print(res, arr)
		for lists in res do: {
		while length(lists) > 0 do: {
			let wal = lists.pop()
			arr.append(wal)
		}
		}
		exp *= 10
	}
	return arr
}
define function hash_helper($arg) -> int(): {
	switch (typeof (arg)):{
		case "integer" then do: { break }
		case "float" then do: { break }
		case "boolean" do : {
			arg = int(arg)
			break
		}
		default do: {
			return -1
			break
		}
   }
	let a = Abs(float(arg)) + 1.0
	let b = Log(a)
	let c = Sin(a * PI) + Cos(b * E)
	let d = c * Sqrt(2) * PHI
	let h = Abs(d) * (10**18)
	return int(h*(h+3)+17)
}
define function hash($arg)-> int():{
	let res = hash_helper(arg)
	if (res !== -1): return res
	let i,H = 1, $PHI
	for item in arg do: {
		let h = hash(item)
		H = H*Sin(h + i) + Cos(h / i)
		H -= Floor(H)
		i++
	}
	return int(Abs(H) * (10**18))
}```
``` CLOCK SIM:
define function draw_clock_body(center, clc_clor, dot_color): {
	~DrawRectangle(WIN_WIDTH/2-200,WIN_HEIGHT/2 - 200, 400, 400, Color(255, 150, 170, 255) )
	DrawCircleV(center, 202, dot_color)
	DrawCircleV(center, 200, clc_clor)
	``v_begin = <400 + 160 * cosx, 300 + 160 * sinx>`
	`v_end = <400 + 195 * cosx, 300 + 195 * sinx>``
	let angle = float()
	for i in 0...12...1 do: {
		angle = float(i * PI / 6)
		DrawLineEx(<400+ 160 * Cos(angle), 300 + 160 * Sin(angle) >, <400+ 195 * Cos(angle), 300 + 195 * Sin(angle) >, 2, dot_color)
	}
}
define function draw_hour(center, hour, minute, color): {
	let angle = float((hour + minute / 60.0) * PI / 6.0 - PI / 2.0)
DrawLineEx(center, <WIN_WIDTH / 2 + 80 * Cos(angle), WIN_HEIGHT / 2 + 80 * Sin(angle) >, 2, color)
}
define function draw_minute(center, minute, second, color): {
	let smooth_min = float(minute) + (float(second) / 60.0)
	let angle = float(smooth_min * PI / 30.0 - PI / 2.0)
	DrawLineEx(center, <WIN_WIDTH / 2 + 120 * Cos(angle), WIN_HEIGHT / 2 + 120 * Sin(angle) >, 2, color)
}
define function draw_second(center, second, color): {
	let angle = float(second * PI / 30.0 - PI / 2.0)
	DrawLineEx(center, <WIN_WIDTH / 2 + 150 * Cos(angle), WIN_HEIGHT / 2 + 150 * Sin(angle) >, 2, color)
}
define function draw_digital_time(time, x, y, size, text_color, has_bg, bg_color): {
	let h = string(time["hour"]) if time["hour"] >= 10 else "0" + string(time["hour"])
	let m = string(time["min"]) if time["min"] >= 10 else "0" + string(time["min"])
	let s = string(time["sec"]) if time["sec"] >= 10 else "0" + string(time["sec"])
	if has_bg: {
		DrawRectangle(x - 6, y-2, 112, 22, text_color)
		DrawRectangle(x - 5, y - 1, 110, 20, bg_color)
		
	}
	DrawText(f'{h} : {m} : {s}', x, y, size, text_color)
}
define function draw_clock(center, clc_clor, dot_color): {
	draw_clock_body(center, clc_clor, dot_color)
	let time_format = Local(Now())
	draw_digital_time(time_format,WIN_WIDTH/2-50,10,20,dot_color,true,clc_clor)
	draw_hour(center, time_format["hour"], time_format["min"], dot_color)
	draw_minute(center, time_format["min"], time_format["sec"], dot_color)
	draw_second(center, time_format["sec"], Color(255, 0, 0, 255))
	DrawCircleV(center, 3, dot_color)
}
define function foo(): {
	InitWindow(WIN_WIDTH, WIN_HEIGHT,"Clock sim")
	let pink = Color(255, 150, 170, 255)
	let yellow = Color(255, 255, 0, 255)
	let center = vector(400, 300)
	let gray = Color(230, 230, 230, 255)
	let black = Color(0, 0, 0, 255)
	let white = Color(255, 255, 255, 255)
	SetTargetFPS(60)
	while (not bool(WindowShouldClose())) do: {
		BeginDrawing()
		ClearBackground(pink)
		~DrawFPS(10, 10)
		~fill_with_flowers(WIN_WIDTH, WIN_HEIGHT, yellow, RADH, RADV, white, true, 1, black)
		~draw_clock(center, white, black)
		EndDrawing()
	}
	CloseWindow()
}```
