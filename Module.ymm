define function coordinant(w, h, x, lam, color, scale: float(1.0), stretch: float(1.0)) -> vector(): {
	return <x + w / 2, - lam(float(x / scale), stretch) + h / 2 >
}
define function draw_function(w, h, lam, color, scale: float(1.0), stretch: float(1.0)): {
	for let i = -w / 2 if i <= w / 2 then i += scale do: {
		DrawLineV(coordinant(w, h, (i), lam, color, scale, stretch), coordinant(w, h, (i + scale), lam, color, scale, stretch), color)
	}
}
