define function f(x) -> int(5): { if x > 1: { return 9 } }
define function g(x:int()): { if x > 1: { return "s" } return 2.5 }
define function main(args): { print(f(0)) print(f(3)) print(g(0)) print(g(3)) let q = 1 q = "str" print(q) let k := 1 try: { k = "x" } catch ConstError do: { print("ce") } let big = 9223372036854775807 print(big + 1) }
