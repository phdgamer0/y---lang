import * from Raylib
import * from Math
import RandChoice from Random
import Vector

let const W = 800
let const H = 800
let const FPS = 60
let const GRID_NUM = 8
let const GRID_LEN = 60
let const BLOCK_LEN = 40
let const BLOCK_LEN_PICKED = GRID_LEN
let const DEFAULT_POS = <W // 2, H * 0.75>
let GAME_OVER = false
let score = 0

define function __model__helper__(iterable) -> list():{
   let block_grid = [[]] * 5
   let i = 0
   for i if i < length(iterable) then i++ do:{
      block_grid[i // 5].append(bool(iterable[i]) if i < 23 else int(iterable[i]))
   }
   if length(iterable) < 25:{
      for i if i < 25 then i++ do:{
         block_grid[i // 5].append(false)
      }
   }
   return block_grid
}
define class Block: {
   #public:
      define function __construct__(pos:vector(DEFAULT_POS)):{
         let self.color = RandChoice(obj.colors)
         let self.pos = pos
         let self.model = RandChoice(obj.models)
         let self.is_dragging = false
         self.drag_offset = <0, 0>
      }
      define function check_for_drag():{
         let x, y = GetMouseX(), GetMouseY()
         let mouse_pos = <x, y>
         if IsMouseButtonPressed(0): {
            let is_inside_x = x >= self.pos[0] and x <= self.pos[0] + (BLOCK_LEN * 5)
            let is_inside_y = y >= self.pos[1] and y <= self.pos[1] + (BLOCK_LEN * 5)
            if is_inside_x and is_inside_y: {
               self.is_dragging = true
               self.drag_offset = mouse_pos - self.pos 
            }
         }
         if self.is_dragging and IsMouseButtonDown(0): {
            self.pos = mouse_pos - self.drag_offset
         }
         if IsMouseButtonReleased(0): {
            self.is_dragging = false
         }
      }
      define function display():{
         let len = BLOCK_LEN_PICKED if self.is_dragging else BLOCK_LEN
         for let i = 0 if i < self.model[-1][-1] then i++ do:{
            for let j = 0 if j < self.model[-1][-2] then j++ do:{
               if self.model[i][j]:{
                  DrawRectangleV(self.pos + <i * len, j * len>, <len, len>, WHITE)
                  DrawRectangleV(self.pos + <1, 1> + <i * len, j * len>, <len, len> - <2 ,2>, self.color)
               }
            }
         }
      }
      define function reset():{
         self.pos = DEFAULT_POS
         self.model = RandChoice(obj.models)
         self.color = RandChoice(obj.colors)
      }
   #private:
   
   let self.drag_offset := vector()
   #protected:
