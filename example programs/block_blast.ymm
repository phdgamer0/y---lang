define class Grid: {
   #public:
      define function __construct__(pos:vector(), offColor:object(BLACK)):{
         let self.MainGrid := [[[false, offColor]] * GRID_NUM for i in range(GRID_NUM)]
         let self.pos = pos
         let self.offColor = offColor
      }
      define function display(block:object()):{
         self.check_for_drop(block)
         for let i = 0 if i < GRID_NUM then i++ do:{
            for let j = 0 if j < GRID_NUM then j++ do:{
               DrawRectangleV(self.pos + GRID_LEN * <i, j>, <GRID_LEN, GRID_LEN>, WHITE)
               DrawRectangleV(self.pos + <1, 1> + GRID_LEN * <i, j>, <GRID_LEN - 2, GRID_LEN - 2>, self.MainGrid[i][j][1])
            }
         }
      }
      define function check_for_drop(block:object()):{
         if block.pos[0] >= self.pos[0] and block.pos[0] <= self.pos[0] + GRID_LEN * GRID_NUM and block.pos[1] >= self.pos[1] and block.pos[1] <= self.pos[1] + GRID_LEN * GRID_NUM and not block.is_dragging:{
            let relative_dist = block.pos - self.pos
            let bestX = (relative_dist[0] + GRID_LEN // 2) // GRID_LEN 
            let bestY = (relative_dist[1] + GRID_LEN // 2) // GRID_LEN
            if bestX + block.model[-1][-1] > GRID_NUM or bestY + block.model[-1][-2] > GRID_NUM:{
               block.pos = DEFAULT_POS
               return
            }
            for let i = 0 if i < block.model[-1][-1] then i++ do:{
               for let j = 0 if j < block.model[-1][-2] then j++ do:{
                  if self.MainGrid[i + bestX][j+ bestY][0] and block.model[i][j]:{
                     block.pos = DEFAULT_POS
                     return
                  }
               }
            }
            for let i = 0 if i < block.model[-1][-1] then i++ do:{
               for let j = 0 if j < block.model[-1][-2] then j++ do:{
                  if block.model[i][j]:{
                     self.MainGrid[i + bestX][j+ bestY] = [true, block.color]
                  }
               }
            }
            self.grid_check()
            self.cleaner()
            block.reset()
            self.CheckGameOver(block)
         }
      }
      define function CheckGameOver(block:object()):{
         for let i = 0 if i <= GRID_NUM - block.model[-1][-1] then i++ do:{
            for let j = 0 if j <= GRID_NUM - block.model[-1][-2] then j++ do:{
               let fits = true
               for let k = 0 if k < block.model[-1][-1] then k++ do:{
                  for let l = 0 if l < block.model[-1][-2] then l++ do:{
                     if block.model[k][l] and self.MainGrid[i + k][j + l][0]:{
                        fits = false
                     }
                  }
               }
               if fits: return None
            }
         }
         GAME_OVER = true
      }
      define function reset():{
         self.MainGrid = [[[false, self.offColor]] * GRID_NUM for i in range(GRID_NUM)]
      }
   #private:
      define function grid_check():{
         for let i = 0 if i < GRID_NUM then i++ do:{
            let flag = true
            for let j = 0 if j < GRID_NUM then j++ do:{
               if not self.MainGrid[i][j][0]: {
                  flag = false
                  break
               }
            }
            if flag: self.cleanable_rows.append(i)
         }
         for let j = 0 if j < GRID_NUM then j++ do:{
            let flag = true
            for let i = 0 if i < GRID_NUM then i++ do:{
               if not self.MainGrid[i][j][0]: {
                  flag = false
                  break
               }
            }
            if flag: self.cleanable_cols.append(j)
         }
      }
      define function cleaner():{
         for i in self.cleanable_rows do:{
            self.MainGrid[i] = [[false, self.offColor]] * GRID_NUM
         }
         for j in self.cleanable_cols do:{
            for let i = 0 if i < GRID_NUM then i++ do:{
               self.MainGrid[i][j] = [false, self.offColor]
            }
         }
         score += (length(self.cleanable_rows) + length(self.cleanable_cols)) * 10
         self.cleanable_rows.clear()
         self.cleanable_cols.clear()
      }
   #protected:
      let self.cleanable_rows = []
      let self.cleanable_cols = []
}
define function main():{
   SetConfigFlags(8192)
   let block = Block(<(W - BLOCK_LEN * 5) // 2, 3 * H // 4 - 2 * BLOCK_LEN>)
   let grid = Grid(<(W - GRID_LEN * GRID_NUM) // 2, 20>)
   InitWindow(W, H, "Block Blast")
   SetTargetFPS(FPS)
   while not WindowShouldClose() do:{
      BeginDrawing()
      ClearBackground(BLACK)
      DrawFPS(10, 10)
      grid.display(block)
      if GAME_OVER:{
         grid.reset()
         score = 0
         GAME_OVER = false
      }
      block.display()
      block.check_for_drag()
      DrawText(f'SCORE: {score}', W - 10 * 12, 20, 20, WHITE)
      
      EndDrawing()
   }
   CloseWindow()
}